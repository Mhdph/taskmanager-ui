{
  "extends": "$app/tsconfig",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "strict": false,
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "paths": { "#lib/*": ["src/lib/*"] }
  }
}
