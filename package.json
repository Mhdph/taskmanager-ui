{
  "name": "gr8r-studio",
  "version": "1.0.0",
  "private": true,
  "description": "Gr8r Studio: a calm, structured project management workspace.",
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
