    "eslint": "^9.39.5",
    "globals": "^15.15.0",
    "lucide": "^0.460.0",
    "prettier": "^3.9.9",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.3",
    "vite-preprocess": "^1.1.2"
  }
